PORT=8787
LOG_FORMAT=pretty
LOG_LEVEL=info

# Comma-separated browser origins for production. Leave empty for local development.
# CORS_ORIGINS=https://your-frontend.example.com

# Set to true after the frontend login flow is enabled.
# AUTH_REQUIRED=false

# Optional: validate a different backend URL with npm run validate:final.
# VALIDATION_API_URL=http://localhost:8787/api

# Optional: point ARIA's backend to a Mastra agent generate endpoint.
# MASTRA_AGENT_URL=http://localhost:4111/api/agents/aria-support-agent/generate
# Provider selection: auto uses Mastra when configured, local forces the knowledge fallback.
# AI_PROVIDER=auto

# Optional: expose Mastra endpoints from the local Express server.
# ENABLE_MASTRA_SERVER=true
# MASTRA_MODEL=google/gemini-2.5-flash

# Recommended for this project: create a Gemini API key in Google AI Studio.
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional Gemini alias also supported by the backend.
# GOOGLE_API_KEY=

# Optional alternative if the model is changed to an OpenAI model.
# OPENAI_API_KEY=

# PostgreSQL migration/runtime configuration.
# SQLite remains the default local runtime. Use DATABASE_ENGINE=postgres only after migration and verification.
# DATABASE_ENGINE=sqlite
# DATABASE_URL=postgresql://user:password@localhost:5432/aria
# DB_POOL_MAX=10
# DB_SSL=false
# POSTGRES_DB=aria
# POSTGRES_USER=aria
# POSTGRES_PASSWORD=
# For the Docker PostgreSQL runtime profile, the host must be the Compose service name.
# POSTGRES_CONTAINER_DATABASE_URL=postgresql://user:password@postgres:5432/aria

# Optional Neo4j graph backend preparation. SQLite remains the default graph store.
# GRAPH_STORE=sqlite
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_MAX_POOL_SIZE=50
# NEO4J_CONNECTION_TIMEOUT_MS=10000
# NEO4J_ENCRYPTED=false

# Retrieval tuning
RETRIEVAL_SEMANTIC_THRESHOLD=0.2
RETRIEVAL_HYBRID_THRESHOLD=0.28
RETRIEVAL_SEMANTIC_WEIGHT=0.7
RETRIEVAL_KEYWORD_WEIGHT=0.3
RETRIEVAL_CANDIDATE_LIMIT=8
RETRIEVAL_GRAPH_BOOST=0.08
AI_CONFIDENCE_THRESHOLD=0.7
