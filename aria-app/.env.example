PORT=8787

# Optional: validate a different backend URL with npm run validate:final.
# VALIDATION_API_URL=http://localhost:8787/api

# Optional: point ARIA's backend to a Mastra agent generate endpoint.
# MASTRA_AGENT_URL=http://localhost:4111/api/agents/aria-support-agent/generate

# Optional: expose Mastra endpoints from the local Express server.
# ENABLE_MASTRA_SERVER=true
# MASTRA_MODEL=google/gemini-2.5-flash

# Recommended for this project: create a Gemini API key in Google AI Studio.
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional Gemini alias also supported by the backend.
# GOOGLE_API_KEY=

# Optional alternative if the model is changed to an OpenAI model.
# OPENAI_API_KEY=
