{
  "name": "aria-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --import tsx --watch server/index.ts",
    "test:e2e": "playwright test",
    "start:server": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "check:api": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/check-api.ts",
    "backup:sqlite": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/backup-sqlite.ts",
    "index:knowledge": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/index-knowledge.ts",
    "evaluate:retrieval": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/evaluate-retrieval.ts",
    "evaluate:adaptation": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/evaluate-adaptation.ts",
    "validate:final": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/validate-final.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "migrate:postgres": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/migrate-postgres.ts",
    "verify:postgres": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/verify-postgres.ts",
    "migrate:neo4j": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/migrate-neo4j.ts",
    "verify:neo4j": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/verify-neo4j.ts",
    "backup:neo4j": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/backup-neo4j.ts",
    "restore:neo4j": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/restore-neo4j.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=1 server/tests/*.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mastra/core": "^1.45.0",
    "@mastra/express": "^1.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.13.0",
    "mastra": "^1.15.0",
    "multer": "^2.5.0",
    "neo4j-driver": "^6.3.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
