{
  "name": "aria-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --import tsx --watch server/index.ts",
    "start:server": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "index:knowledge": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/index-knowledge.ts",
    "evaluate:retrieval": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/evaluate-retrieval.ts",
    "evaluate:adaptation": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/evaluate-adaptation.ts",
    "validate:final": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/validate-final.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mastra/core": "^1.45.0",
    "@mastra/express": "^1.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.17.0",
    "mastra": "^1.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
